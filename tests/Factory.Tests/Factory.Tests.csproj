<Project Sdk="Microsoft.NET.Sdk">
  <!-- @summary: Dependency-free test runner (no NuGet). Run: dotnet run, project tests/Factory.Tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Factory.Core/Factory.Core.csproj" />
    <Compile Include="../../src/Sim.Cli/Checks.cs" Link="Linked/Checks.cs" />
  </ItemGroup>
</Project>
